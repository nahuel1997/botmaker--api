# ─── Puerto del servidor ───────────────────────────────────────────────────────
PORT=3000

# ─── API Key para autenticar las requests de Botmaker ──────────────────────────
# Generá un string seguro, ej: openssl rand -hex 32
API_KEY=tu_api_key_secreta_aqui

# ─── Salesforce OAuth (Connected App) ─────────────────────────────────────────
# Credenciales de la Connected App creada en Setup → App Manager
SF_CLIENT_ID=tu_consumer_key_aqui
SF_CLIENT_SECRET=tu_consumer_secret_aqui

# Usuario y contraseña de Salesforce + Security Token
# El Security Token se obtiene en: Configuración → Mis datos personales → Restablecer mi token
SF_USERNAME=m.villar@brandformancegroup.la
SF_PASSWORD=tu_password_aqui
SF_SECURITY_TOKEN=tu_security_token_aqui

# Entorno de Salesforce: 'login' para producción, 'test' para sandbox
SF_LOGIN_URL=https://login.salesforce.com

# ─── Campo CUIT en Salesforce ──────────────────────────────────────────────────
# Nombre API del campo donde se guarda el CUIT en el objeto Account
# Verificar en Setup → Administrador de objetos → Account → Campos
SF_CUIT_FIELD=CUIT__c
